+void Mpv::add_volume(double delta) {
+	if(!created)
+		return;
+
+	char delta_str[64];
+	snprintf(delta_str, sizeof(delta_str), "%f", delta);
+	const char *cmd[] = { "add", "volume", delta_str, nullptr };
+	mpv_command_async(mpv, 0, cmd);
+}
