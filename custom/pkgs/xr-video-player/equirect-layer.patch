+void Mpv::set_layer_target(XrSwapchain swapchain, const std::vector<GLuint> &images, int width, int height) {
+	std::lock_guard<std::mutex> lock(layer_mutex);
+	layer_images = images;
+	layer_fbos.assign(images.size(), 0);
+	layer_width = width;
+	layer_height = height;
+	layer_swapchain = swapchain;
+}
+
+// The EGL mutex is shared with the XR frame loop, which holds it through xrEndFrame,
+// so swapchain acquire/release are serialised with frame submission.
+void Mpv::draw_to_layer() {
+	std::lock_guard<std::mutex> lock(layer_mutex);
+	XrSwapchainImageAcquireInfo acquire_info = {XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO, nullptr};
+	uint32_t index = 0;
+	pthread_mutex_lock(egl_data.mutex);
+	XrResult res = xrAcquireSwapchainImage(layer_swapchain, &acquire_info, &index);
+	pthread_mutex_unlock(egl_data.mutex);
+	if(XR_FAILED(res) || index >= layer_images.size()) {
+		fprintf(stderr, "Error: xrAcquireSwapchainImage failed: %d\n", res);
+		return;
+	}
+
+	XrSwapchainImageWaitInfo wait_info = {XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO, nullptr, XR_INFINITE_DURATION};
+	xrWaitSwapchainImage(layer_swapchain, &wait_info);
+
+	gl_egl_device_enter_context(&egl_data);
+	if(!layer_fbos[index]) {
+		glGenFramebuffers(1, &layer_fbos[index]);
+		glBindFramebuffer(GL_FRAMEBUFFER, layer_fbos[index]);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, layer_images[index], 0);
+		glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	}
+	// Swapchain images use GL's bottom-up row order.
+	draw(layer_fbos[index], layer_width, layer_height, true);
+	EGLSyncKHR sync = eglCreateSyncKHR(egl_data.display, EGL_SYNC_FENCE_KHR, nullptr);
+	glFlush();
+	gl_egl_device_leave_context(&egl_data);
+
+	// Wait outside the lock so the XR frame loop keeps running while mpv's GPU work finishes.
+	if(sync != EGL_NO_SYNC_KHR) {
+		eglClientWaitSyncKHR(egl_data.display, sync, 0, EGL_FOREVER_KHR);
+		eglDestroySyncKHR(egl_data.display, sync);
+	}
+
+	XrSwapchainImageReleaseInfo release_info = {XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO, nullptr};
+	pthread_mutex_lock(egl_data.mutex);
+	res = xrReleaseSwapchainImage(layer_swapchain, &release_info);
+	pthread_mutex_unlock(egl_data.mutex);
+	if(XR_SUCCEEDED(res))
+		layer_frames++;
+}
