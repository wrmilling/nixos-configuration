+bool CMainApplication::CreateVideoSwapchain(int width, int height)
+{
+	gl_egl_device_enter_context(&egl_data);
+	XrSwapchainCreateInfo info = {
+	    .type = XR_TYPE_SWAPCHAIN_CREATE_INFO,
+	    .next = NULL,
+	    .createFlags = 0,
+	    .usageFlags = XR_SWAPCHAIN_USAGE_SAMPLED_BIT | XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT,
+	    .format = m_colorFormat,
+	    .sampleCount = 1,
+	    .width = (uint32_t)width,
+	    .height = (uint32_t)height,
+	    .faceCount = 1,
+	    .arraySize = 1,
+	    .mipCount = 1,
+	};
+	XrResult result = xrCreateSwapchain(session, &info, &video_swapchain);
+	std::vector<GLuint> textures;
+	if (xr_check(instance, result, "Failed to create video swapchain")) {
+		uint32_t count = 0;
+		xrEnumerateSwapchainImages(video_swapchain, 0, &count, NULL);
+		std::vector<XrSwapchainImageOpenGLKHR> imgs(count, {XR_TYPE_SWAPCHAIN_IMAGE_OPENGL_KHR});
+		xrEnumerateSwapchainImages(video_swapchain, count, &count, (XrSwapchainImageBaseHeader*)imgs.data());
+		for (const XrSwapchainImageOpenGLKHR &img : imgs)
+			textures.push_back(img.image);
+		printf("video swapchain %dx%d, %u images\n", width, height, count);
+	}
+	gl_egl_device_leave_context(&egl_data);
+	if (textures.empty())
+		return false;
+	mpv.set_layer_target(video_swapchain, textures, width, height);
+	return true;
+}
